<?xml version="1.0" encoding="utf-8"?>
<!--
    自适应图标的背景层（API 26+）。
    深夜蓝的径向渐变，中间稍亮，正好把 neoncup 的霓虹线条衬出来。
    前景层是 mipmap-*/neoncup_foreground.webp（透明底），两层叠在一起才有视差。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:type="radial"
        android:centerX="0.5"
        android:centerY="0.45"
        android:gradientRadius="0.78"
        android:startColor="#1D2F6B"
        android:centerColor="#0B1228"
        android:endColor="#04060D" />

</shape>
